{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Screener.in Stock Scraper Input",
  "type": "object",
  "properties": {
    "screenUrl": {
      "title": "Screen URL",
      "type": "string",
      "description": "Screener.in screen URL to scrape stocks from",
      "editor": "textfield",
      "prefill": "https://www.screener.in/screens/1/All-Stocks/"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of stocks to scrape",
      "minimum": 1,
      "maximum": 500,
      "default": 50,
      "editor": "number",
      "prefill": 3
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "editor": "proxy",
      "description": "Proxy settings"
    }
  },
  "required": ["screenUrl", "maxResults"]
}
