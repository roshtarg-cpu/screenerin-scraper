{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "title": "Screener.in Stock Scraper Input",
  "type": "object",
  "properties": {
    "sector": {
      "title": "Sector",
      "type": "string",
      "description": "Industry sector to filter stocks",
      "editor": "select",
      "enum": ["All", "IT", "Pharma", "Banking", "Auto", "FMCG", "Infrastructure", "Telecom", "Power", "Metals", "Oil & Gas"],
      "default": "All",
      "prefill": "All"
    },
    "minMarketCap": {
      "title": "Minimum Market Cap (Cr)",
      "type": "integer",
      "description": "Minimum market capitalization in crores",
      "editor": "number",
      "minimum": 0,
      "default": 0,
      "prefill": 100
    },
    "maxPE": {
      "title": "Maximum P/E Ratio",
      "type": "number",
      "description": "Maximum price-to-earnings ratio (filter out overvalued stocks)",
      "editor": "number",
      "minimum": 0,
      "default": 50,
      "prefill": 25
    },
    "minDividendYield": {
      "title": "Minimum Dividend Yield (%)",
      "type": "number",
      "description": "Minimum dividend yield percentage",
      "editor": "number",
      "minimum": 0,
      "maximum": 20,
      "default": 0,
      "prefill": 2
    },
    "minROE": {
      "title": "Minimum ROE (%)",
      "type": "number",
      "description": "Minimum return on equity percentage",
      "editor": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "prefill": 15
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of stocks to scrape",
      "minimum": 1,
      "maximum": 500,
      "default": 50,
      "editor": "number",
      "prefill": 3
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "editor": "proxy",
      "description": "Proxy settings"
    }
  },
  "required": ["sector", "maxResults"]
}
